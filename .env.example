# Server Configuration
PORT=3100
HOST=localhost
NODE_ENV=development
X_TZ=America/Sao_Paulo
TRUST_PROXY=false

# User Service Configuration
USER_ENCRYPTION_KEY=your-encryption-key-here
# Provide a long, randomly generated value for JWT_SECRET
JWT_SECRET=replace-with-strong-secret

# Google OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3100/api/auth/google/callback
BASE_URL=http://localhost:3100

OPEN_ROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DB_USER=db_user
DB_PASSWORD=xxxxxxxxxxxxx
DB_NAME=db_name
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}?schema=public
ADMIN_EMAIL=admin@email.com
ADMIN_PASSWORD=xxxxxxxxxxxxxxxxxxx
TRUST_PROXY=true
