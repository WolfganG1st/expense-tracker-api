{
	"name": "expense-tracker-api",
	"version": "1.0.0",
	"description": "TypeScript API for managing credit card transactions",
	"main": "dist/index.js",
	"scripts": {
		"build": "prisma generate && tsc && tsc-alias",
		"build:watch": "prisma generate && tsc --watch=src && tsc-alias",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"start": "tsx src/index.ts",
		"dev": "dotenv -- cross-env NODE_ENV=development tsx src/index.ts --watch=src",
		"dev:docker": "dotenv -e docker.env -- cross-env NODE_ENV=development tsx src/index.ts --watch=src",
		"dev:debug": "dotenv -- cross-env NODE_ENV=development tsx src/index.ts --watch=src --inspect",
		"lint": "biome check --config-path ./biome.json .",
		"format": "biome format --config-path ./biome.json --write .",
		"test": "dotenv -- jest --coverage",
		"clean": "rimraf dist node_modules",
		"prepare": "husky",
		"docker:up": "./scripts/docker-up.sh",
		"docker:down": "./scripts/docker-down.sh",
		"docker:bash": "./scripts/docker-bash.sh",
		"security:test": "cross-env JWT_SECRET=testsecret dotenv -- jest --config jest.security.config.js",
		"security:report": "cross-env JWT_SECRET=testsecret dotenv -- ./scripts/run-security-tests.sh",
		"knip": "knip --no-config-hints",
		"knip:production": "knip --no-config-hints --production",
		"list": "node scripts/dev.js list",
		"generate": "node scripts/dev.js generate",
		"parse-prd": "node scripts/dev.js parse-prd",
		"seed": "tsx prisma/seed.ts",
		"seed:docker": "dotenv -e docker.env -- prisma db seed",
		"prisma:migrate": "prisma migrate dev",
		"prisma:docker:migrate": "dotenv -e docker.env -- prisma migrate deploy",
		"prisma:docker:studio": "dotenv -e docker.env -- prisma studio",
		"prisma:docker:generate": "dotenv -e docker.env -- prisma generate",
		"process-account-statement": "tsx src/scripts/process-account-statement.ts"
	},
	"keywords": [
		"credit",
		"expenses"
	],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@fastify/cookie": "^11.0.2",
		"@fastify/cors": "^11.0.1",
		"@fastify/helmet": "13.0.1",
		"@fastify/jwt": "^9.1.0",
		"@fastify/multipart": "^9.0.3",
		"@fastify/oauth2": "^8.1.2",
		"@fastify/rate-limit": "^10.2.2",
		"@fastify/static": "8.2.0",
		"@fastify/swagger": "^9.4.2",
		"@fastify/swagger-ui": "^5.2.2",
		"@prisma/client": "^6.8.2",
		"bcryptjs": "^3.0.2",
		"chalk": "^5.0.0",
		"csv-parse": "5.6.0",
		"fastify": "^5.3.3",
		"fastify-plugin": "5.0.1",
		"fastify-type-provider-zod": "^5.0.1",
		"google-auth-library": "^10.0.0",
		"jsonrepair": "^3.12.0",
		"multer": "2.0.1",
		"openai": "^5.0.0",
		"optional": "0.1.4",
		"pino-pretty": "^13.0.0",
		"prismock": "^1.35.4",
		"sharp": "0.34.2",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.19.3",
		"zod": "^3.25.61",
		"zod-to-json-schema": "^3.24.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.0.6",
		"@total-typescript/shoehorn": "0.1.2",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.13.14",
		"@types/supertest": "^6.0.3",
		"cross-env": "^7.0.3",
		"dotenv-cli": "^8.0.0",
		"husky": "9.1.7",
		"jest": "^30.0.0",
		"jest-html-reporter": "^4.1.0",
		"knip": "5.61.3",
		"pino": "^9.7.0",
		"prisma": "^6.8.2",
		"rimraf": "^6.0.1",
		"supertest": "^7.1.0",
		"ts-jest": "^29.3.0",
		"typescript": "5.5.2"
	},
	"type": "module",
	"prisma": {
		"schema": "prisma/schema.prisma",
		"seed": "tsx prisma/seed.ts"
	}
}
